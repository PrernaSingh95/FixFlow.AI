# FixFlow AI Environment Configuration

# AI Provider Keys (Optional: works out of the box with built-in heuristic vector fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Database Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./backend/fixflow.db

# Vector Duplicate Detection Threshold
DUPLICATE_SIMILARITY_THRESHOLD=0.80

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
